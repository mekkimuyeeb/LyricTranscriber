# lyrics-transcriber Environment Configuration
# Enables LLM-assisted gap fixes via local Ollama instance
USE_AGENTIC_AI=1
PRIVACY_MODE=1
AGENTIC_AI_MODEL=ollama/qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Timeout and retry settings for local LLM calls
AGENTIC_TIMEOUT_SECONDS=120.0
OLLAMA_MAX_RETRIES=3
OLLAMA_TIMEOUT_SECONDS=60

# Local Whisper settings (used when cloud AudioShake/RunPod keys are not set)
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
